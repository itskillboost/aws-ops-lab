<mxfile host="opslab"><diagram name="2. 커밋이 반영되는 길 (Sync)"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="① 커밋·푸시&lt;br&gt;git push → 오늘 브랜치&lt;br&gt;끝 커밋이 바뀐다" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#FFF2CC;strokeColor=#D6B656;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="30" width="212" height="105" as="geometry"/></mxCell><mxCell id="c2" value="② 감지&lt;br&gt;1분마다(또는 Refresh)&lt;br&gt;Git 을 다시 본다" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="252" y="30" width="212" height="105" as="geometry"/></mxCell><mxCell id="c3" value="③ 렌더링&lt;br&gt;repo-server:&lt;br&gt;Helm 차트 + valueFiles&lt;br&gt;+ 매개변수 → 매니페스트" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="484" y="30" width="212" height="105" as="geometry"/></mxCell><mxCell id="c4" value="④ 비교(diff)&lt;br&gt;controller: Git ↔ 클러스터&lt;br&gt;다르면 OutOfSync" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="716" y="30" width="212" height="105" as="geometry"/></mxCell><mxCell id="c5" value="⑤ 동기화(Sync)&lt;br&gt;자동 동기화가 켜져 있으면&lt;br&gt;바로 적용 → Synced" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="948" y="30" width="212" height="105" as="geometry"/></mxCell><mxCell id="c6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounde