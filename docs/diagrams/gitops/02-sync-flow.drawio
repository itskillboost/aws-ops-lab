건강 판정&lt;br&gt;모든 리소스 Healthy&lt;br&gt;→ Synced·Healthy&lt;br&gt;(Progressing 이면 기다림)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#FFFFFF;strokeColor=#82B366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="880" y="210" width="250" height="120" as="geometry"/></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="동기화가 멈추는 곳 (gitops-3·5·6)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="20" y="390" width="1140" height="140" as="geometry"/></mxCell><mxCell id="c19" value="③ 렌더링 실패&lt;br&gt;values 파일 없음&lt;br&gt;→ ComparisonError" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#FFFFFF;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="40" y="425" width="205" height="90" as="geometry"/></mxCell><mxCell id="c20" value="③④ 부품 고장&lt;br&gt;repo-server 0 · 토큰 만료&lt;br&gt;→ ComparisonError" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#FFFFFF;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="264" y="425" width="205" height="90" as="geometry"/></mxCell><mxCell id="c21" value="PreSync 훅 실패&lt;br&gt;→ SyncFailed&lt;br&gt;(hook failed)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#FFFFFF;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="488" y="425" width="205" height="90" as="geometry"/></mxCell><mxCell id="c22" value="wave 순서 오류&lt;br&gt;앱이 설정을 못 찾음&lt;br&gt;→ waiting for healthy" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#FFFFFF;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="712" y="425" width="205" height="90" as="geometry"/></mxCell><mxCell id="c23" value="새 파드 미준비&lt;br&gt;readiness 실패&lt;br&gt;→ Progressing 고착" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#FFFFFF;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="936" y="425" width="205" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>