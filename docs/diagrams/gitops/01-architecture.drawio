<mxfile host="opslab"><diagram name="1. 오늘 만드는 GitOps 구조"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="GitHub 내 Fork — 오늘 브랜치 (정답)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fillColor=#F5F5F5;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="330" height="560" as="geometry"/></mxCell><mxCell id="c2" value="gitops/apps/ (앱 목록 = 목차)&lt;br&gt; templates/prod.yaml → opslab-prod&lt;br&gt; templates/dev.yaml → opslab-dev" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#F5F5F5;strokeColor=#333333;fontStyle=1;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="35" y="60" width="300" height="85" as="geometry"/></mxCell><mxCell id="c3" value="gitops/envs/ (환경별 기입 값)&lt;br&gt; prod/values.yaml  (Vault·HPA·점검 훅)&lt;br&gt; dev/values.yaml   (파드 1개, DB 없음)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#F5F5F5;strokeColor=#333333;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="35" y="165" width="300" height="85" as="geometry"/></mxCell><mxCell id="c4" value="charts/opslab-app/ (설치 틀)&lt;br&gt;Deployment·Service·HPA&lt;br&gt;ConfigMap(wave -1)·점검 Job(PreSync)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#F5F5F5;strokeColor=#333333;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="35" y="270" width="300" height="85" as="geometry"/></mxCell><mxCell id="c5" value="나 (CloudShell ~/fork)&lt;br&gt;git commit → git push" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#FFF2CC;strokeColor=#D6B656;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="35" y="395" width="300" height="60" as="geometry"/></mxCell><mxCell id="c6" value="학번·계정 ID 는 Git 에 쓰지 않는다 → 루트 앱이 값으로 넘긴다" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;text;strokeCol