<mxfile host="opslab"><diagram name="3. 수동 변경과 자동 치유"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Git (정답)&lt;br&gt;APP_ERROR_RATE &quot;0&quot;&lt;br&gt;replicas 2" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#F5F5F5;strokeColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="200" height="90" as="geometry"/></mxCell><mxCell id="c2" value="클러스터 (실제)&lt;br&gt;Deployment opslab-app" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#326CE5;fontColor=#ffffff;strokeColor=#1F4FB0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="440" y="60" width="220" height="90" as="geometry"/></mxCell><mxCell id="c3" value="사람: kubectl set env&lt;br&gt;APP_ERROR_RATE=0.5" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#F8CECC;strokeColor=#B85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="440" y="210" width="220" height="65" as="geometry"/></mxCell><mxCell id="c4" value="Sync" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c5" value="diff → OutOfSync" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.7;entryX=1;entryY=0.7;" edge="1" parent="1" source="c2" target="c1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c6" value="수동 변경" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c7" value="selfHeal: true (자동 치유)&lt;br&gt;→ 몇 초 안에 Git 값으로 되돌림&lt;br&gt;긴급 조치도 되돌린다!&lt;br&gt;→ 고칠 곳은 Git" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="720" y="40" width="300" height="100" as="geometry"/></mxCell><mxCell id="c8" value="selfHeal: false&lt;br&gt;→ OutOfSync 로 표시만 하고 그대로 둠&lt;br&gt;누가 바꿨는지 모른 채 장애가 남는다" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="720" y="160" width="300" height="90" as="geometry"/></mxCell><mxCell id="c9" value="HPA 와 replicas — 둘 다 파드 수를 정하려 하면" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fillColor=#FFFFFF;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="20" y="310" width="1000" height="170" as="geometry"/></mxCell><mxCell id="c10" value="HPA: 최소 3개" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="355" width="180" height="55" as="geometry"/></mxCell><mxCell id="c11" value="Argo CD: Git 의 replicas 2" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="355" width="220" height="55" as="geometry"/></mxCell><mxCell id="c12" value="3으로" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="2로" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;exitX=0;exitY=0.7;entryX=1;entryY=0.7;" edge="1" parent="1" source="c11" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="해결: ignoreDifferences /spec/replicas&lt;br&gt;+ RespectIgnoreDifferences=true&lt;br&gt;→ 파드 수는 HPA 에게 맡긴다" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="580" y="345" width="420" height="80" as="geometry"/></mxCell><mxCell id="c15" value="서로 되돌리기(세대 번호가 계속 올라감, 파드가 생겼다 사라짐)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="500" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>