<mxfile host="opslab"><diagram name="4. GitOps 장애 진단 순서"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="증상부터&lt;br&gt;(사용자 오류·배포 미반영)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#FFF2CC;strokeColor=#D6B656;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="170" width="180" height="80" as="geometry"/></mxCell><mxCell id="c2" value="① argocd app list / get&lt;br&gt;Sync · Health · 마지막 작업" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="250" y="170" width="220" height="80" as="geometry"/></mxCell><mxCell id="c3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c4" value="CONDITION 에 ComparisonError&lt;br&gt;→ values 경로 · 저장소 연결&lt;br&gt;(argocd repo list)&lt;br&gt;· repo-server Ready?" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="530" y="20" width="280" height="95" as="geometry"/></mxCell><mxCell id="c5" value="마지막 작업 Failed·Running&lt;br&gt;→ 메시지: hook failed /&lt;br&gt;waiting for healthy (wave)&lt;br&gt;→ 훅 Job 로그 · 파드 describe" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="530" y="130" width="280" height="105" as="geometry"/></mxCell><mxCell id="c6" value="OutOfSync 가 계속 바뀜&lt;br&gt;→ argocd app diff&lt;br&gt;자동 치유·HPA·사람이 다툼" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="530" y="250" width="280" height="85" as="geometry"/></mxCell><mxCell id="c7" value="Synced·Healthy 인데 장애&lt;br&gt;→ 리비전 = 브랜치 끝?&lt;br&gt;아니면 controller 멈춤&lt;br&gt;맞으면 커밋 내용이 원인" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="530" y="350" width="280" height="95" as="geometry"/></mxCell><mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c2" target="c4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="500" y="210"/><mxPoint x="500" y="67"/></Array></mxGeometry></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c2" target="c5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="500" y="210"/><mxPoint x="500" y="182"/></Array></mxGeometry></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c2" target="c6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="500" y="210"/><mxPoint x="500" y="292"/></Array></mxGeometry></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c2" target="c7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="500" y="210"/><mxPoint x="500" y="397"/></Array></mxGeometry></mxCell><mxCell id="c12" value="② 무엇이 바뀌었나&lt;br&gt;git log · argocd app history&lt;br&gt;(누가 언제 어떤 커밋)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#FFE