<mxfile host="opslab"><diagram name="3. 파드 IP 는 어디서 오나"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="앱 서브넷 10.0.10.0/24 — 남은 IP(AvailableIpAddressCount)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fillColor=#E9F3E6;strokeColor=#7AA116;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="700" height="360" as="geometry"/></mxCell><mxCell id="c2" value="노드(EC2 m6i.large) — ENI 최대 3개 × IP 10개" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fillColor=#EAF2FB;strokeColor=#2F6FB3;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="480" height="300" as="geometry"/></mxCell><mxCell id="c3" value="ENI 1(기본)&lt;br&gt;IP 10개 — 사용 중 파드에 배분" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="60" y="100" width="200" height="80" as="geometry"/></mxCell><mxCell id="c4" value="ENI 2(웜 풀)&lt;br&gt;미리 받아 둔 여분 IP" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="290" y="100" width="200" height="80" as="geometry"/></mxCell><mxCell id="c5" value="ENI 3&lt;br&gt;필요할 때 더 붙인다&lt;br&gt;(MAX_ENI 가 막으면 못 붙임)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="210" width="200" height="90" as="geometry"/></mxCell><mxCell id="c6" value="ipamd(aws-node)&lt;br&gt;파드가 뜰 때 IP 를 하나 준다&lt;br&gt;여분이 모자라면 ENI·IP 를 더 받는다" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="290" y="210" width="210" height="110" as="geometry"/></mxCell><mxCell id="c7" value="다른 팀 ENI · 노드 · LB 가&lt;br&gt;서브넷 IP 를 쓰고 있다" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="540" y="120" width="160" height="80" as="geometry"/></mxCell><mxCell id="c8" value="IP 를 못 받으면" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="760" y="20" width="400" height="360" as="geometry"/></mxCell><mxCell id="c9" value="파드: ContainerCreating 에서 멈춤&lt;br&gt;이벤트: FailedCreatePodSandBox&lt;br&gt;&quot;failed to assign an IP address&quot;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#FFFFFF;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="780" y="60" width="360" height="90" as="geometry"/></mxCell><mxCell id="c10" value="확인: 서브넷 남은 IP&lt;br&gt;aws ec2 describe-subnets&lt;br&gt;노드 ENI·aws-node 설정(MAX_ENI 등)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#FFFFFF;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="780" y="170" width="360" height="90" as="geometry"/></mxCell><mxCell id="c11" value="대책: 남는 ENI 정리 · 서브넷 추가&lt;br&gt;· 접두사 위임(prefix delegation)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="780" y="280" width="360" height="80" as="geometry"/></mxCell><mxCell id="c12" value="여분에서 배분" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="c6" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="모자라면" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge=