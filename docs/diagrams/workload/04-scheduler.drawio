<mxfile host="opslab"><diagram name="4. 스케줄러 — 노드 고르기"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="새 파드&lt;br&gt;requests: cpu 100m, memory 128Mi&lt;br&gt;nodeSelector · tolerations" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#326CE5;fontColor=#ffffff;strokeColor=#1F4FB0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="150" width="230" height="90" as="geometry"/></mxCell><mxCell id="c2" value="필터 ① 자리가 있나?&lt;br&gt;requests ≤ Allocatable − 이미 예약된 합&lt;br&gt;(실제 사용량이 아니라 &#x27;예약 숫자&#x27;)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="300" y="30" width="330" height="80" as="geometry"/></mxCell><mxCell id="c3" value="필터 ② 지정석 조건이 맞나?&lt;br&gt;nodeSelector 라벨이 노드에 있나" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="300" y="150" width="330" height="80" as="geometry"/></mxCell><mxCell id="c4" value="필터 ③ 출입 제한을 통과하나?&lt;br&gt;노드 taint ↔ 파드 toleration" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="300" y="270" width="330" height="80" as="geometry"/></mxCell><mxCell id="c5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0;entryY=0.5;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="135" y="70"/></Array></mxGeometry></mxCell><mxCell id="c6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c1" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mx