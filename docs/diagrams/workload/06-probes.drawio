<mxfile host="opslab"><diagram name="6. probe — 건강검진"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="컨테이너 시작" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#F5F5F5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="150" width="140" height="60" as="geometry"/></mxCell><mxCell id="c2" value="컨테이너 재시작&lt;br&gt;(RESTARTS +1 · 반복되면 CrashLoopBackOff)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#F8CECC;strokeColor=#B85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="200" y="15" width="300" height="70" as="geometry"/></mxCell><mxCell id="c3" value="startup probe&lt;br&gt;&#x27;출근 준비 끝났니?&#x27;&lt;br&gt;(오늘: 2초 × 30회 = 최대 60초)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#FFF2CC;strokeColor=#D6B656;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="210" y="140" width="230" height="80" as="geometry"/></mxCell><mxCell id="c4" value="liveness probe&lt;br&gt;&#x27;살아 있니?&#x27;&lt;br&gt;(오늘: 10초 간격 · timeout 2초 · 3회)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#FFF2CC;strokeColor=#D6B656;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="580" y="10" width="270" height="80" as="geometry"/></mxCell><mxCell id="c5" value="readiness probe&lt;br&gt;&#x27;손님 받을 준비 됐니?&#x27;&lt;br&gt;(오늘: 5초 간격 · 2회)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#FFF2CC;strokeColor=#D6B656;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="580" y="250" width="270" height="80" as="geometry"/></mxCell><mxCell id="c6" value="정상 — 계속 반복 검사" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="920" y="20" width="280" height="60" as="geometry"/></mxCell><mxCell id="c7" value="Service 명단(Endpoints)에서 빠짐&lt;br&gt;→ 트래픽 안 받음, 재시작은 안 함&lt;br&gt;성공하면 다시 명단에 들어감" style="rou