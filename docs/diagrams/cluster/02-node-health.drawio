<mxfile host="opslab"><diagram name="2. 노드의 건강"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="관제탑(컨트롤 플레인)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="620" y="20" width="420" height="250" as="geometry"/></mxCell><mxCell id="c2" value="노드 컨트롤러&lt;br&gt;&quot;40초 동안 보고가 없으면&lt;br&gt;Ready=Unknown(NotReady)&quot;&lt;br&gt;&quot;5분 지나면 파드를 다른 노드로&quot;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#FFFFFF;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="640" y="60" width="380" height="110" as="geometry"/></mxCell><mxCell id="c3" value="노드 상태(Conditions)&lt;br&gt;Ready · MemoryPressure ·&lt;br&gt;DiskPressure · PIDPressure" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#FFFFFF;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="640" y="185" width="380" height="70" as="geometry"/></mxCell><mxCell id="c4" value="노드(EC2) 안" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fillColor=#EAF2FB;strokeColor=#2F6FB3;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="560" height="560" as="geometry"/></mxCell><mxCell id="c5" value="kubelet (현장 반장)&lt;br&gt;· 10초마다 &quot;살아 있음&quot; 보고(Lease)&lt;br&gt;· 자원 감시 → 압박이면 조건 True + 파드 축출&lt;br&gt;· 로그: journalctl -u kubelet" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="520" height="110" as="geometry"/></mxCell><mxCell id="c6" value="containerd (작업자)&lt;br&gt;· 컨테이너 실행&lt;br&gt;· 로그: journalctl -u containerd" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="40" y="195" width="520" height="80" as="geometry"/></mxCell><mxCell id="c7" value="systemd — 두 서비스를 켜고 끈다&lt;br&gt;systemctl status kubelet containerd" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="520" height="60" as="geometry"/></mxCell><mxCell id="c8" value="축출 기준(실습 노드 설정)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="520" height="180" as="geometry"/></mxCell><mxCell id="c9" value="메모리   memory.available &amp;lt; 100Mi  → MemoryPressure&lt;br&gt;디스크   nodefs.available &amp;lt; 10%     → DiskPressure&lt;br&gt;PID      pid.available &amp;lt; 25%         → PIDPressure&lt;br&gt;(실습 노드는 프로세스 한도 pid_max=8192)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#FFFFFF;strokeColor=#D6B656;align=left;spacingLeft=10;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="55" y="415" width="490" height="120" as="geometry"/></mxCell><mxCell id="c10" value="Lease 갱신" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="c5" target="c2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="조건 보고" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.8;entryX=0;entryY=0.5;" edge="1" parent="1" source="c5" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="컨테이너 띄워라" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="NotReady 의 세 갈래(cluster-1 · cluster-3)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="620" y="300" width="420" height="280" as="geometry"/></mxCell><mxCell id="c14" value="kubelet 이 멈췄다 → 보고 자체가 끊김&lt;br&gt;(Ready=Unknown, &quot;Kubelet stopped posting&quot;)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#FFFFFF;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="635" y="340" width="390" height="65" as="geometry"/></mxCell><mxCell id="c15" value="containerd 가 멈췄다 → kubelet 은 살아&lt;br&gt;&quot;런타임이 안 된다&quot;고 보고" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#FFFFFF;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="635" y="415" width="390" height="65" as="geometry"/></mxCell><mxCell id="c16" value="관제탑이 노드를 거절한다(인증 실패)&lt;br&gt;→ kubelet 은 살아 있지만 보고가 거부됨" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#FFFFFF;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="635" y="490" width="390" height="65" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>