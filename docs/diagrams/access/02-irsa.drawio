<mxfile host="opslab"><diagram name="2. IRSA 로 역할을 빌리는 길"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="① 서비스 계정 어노테이션&lt;br&gt;eks.amazonaws.com/role-arn&lt;br&gt;= 빌릴 역할의 ARN" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="212" height="110" as="geometry"/></mxCell><mxCell id="c2" value="② 파드가 뜰 때&lt;br&gt;주입기가 env AWS_ROLE_ARN·&lt;br&gt;AWS_WEB_IDENTITY_&lt;br&gt;TOKEN_FILE 과 토큰 파일을 넣는다" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="252" y="40" width="212" height="110" as="geometry"/></mxCell><mxCell id="c3" value="③ 앱 → STS&lt;br&gt;AssumeRoleWithWebIdentity&lt;br&gt;(역할 ARN + 토큰)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#FFF4E5;strokeColor=#ED7100;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="484" y="40" width="212" height="110" as="geometry"/></mxCell><mxCell id="c4" value="④ STS 의 확인&lt;br&gt;OIDC 공급자로 토큰 서명 확인&lt;br&gt;신뢰 정책의 aud·sub 와 비교" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#FFF4E5;strokeColor=#ED7100;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="716" y="40" width="212" height="110" as="geometry"/></mxCell><mxCell id="c5" value="⑤ 임시 자격증명&lt;br&gt;1시간짜리 키 → /aws 가&lt;br&gt;assumed-role/&amp;lt;역할&amp;gt; 표시" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#FFF4E5;strokeColor=#ED7100;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="948" y="40" width="212" height="110" as="geometry"/></mxCell><mxCell id="c6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="어디가 틀리면 무엇이 보이나 (/aws 응답 · 앱 로그)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="20" y="190" width="1140" height="200" as="geometry"/></mxCell><mxCell id="c11" value="① 역할 ARN 오타&lt;br&gt;→ AccessDenied: Not authorized to&lt;br&gt;perform sts:AssumeRoleWithWebIdentity&lt;br&gt;(역할이 없음)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#FFFFFF;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="260" height="130" as="geometry"/></mxCell><mxCell id="c12" value="④ 신뢰 정책 sub 불일치&lt;br&gt;→ 같은 AccessDenied&lt;br&gt;(역할은 있으나 이 서비스 계정은 불허)&lt;br&gt;신뢰 정책의 네임스페이스:이름 확인" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#FFFFFF;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="320" y="230" width="260" height="130" as="geometry"/></mxCell><mxCell id="c13" value="④ OIDC 공급자 없음&lt;br&gt;→ InvalidIdentityToken:&lt;br&gt;No OpenIDConnect provider found" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#FFFFFF;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="600" y="230" width="260" height="130" as="geometry"/></mxCell><mxCell id="c14" value="확인 순서&lt;br&gt;어노테이션 → 파드 env(AWS_*)&lt;br&gt;→ 신뢰 정책(aud·sub) → OIDC 공급자" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="880" y="230" width="260" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>