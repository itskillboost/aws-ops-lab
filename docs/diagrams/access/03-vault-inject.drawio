<mxfile host="opslab"><diagram name="3. 금고에서 비밀을 꺼내 오는 길"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="① 주입&lt;br&gt;Agent Injector 가 파드에&lt;br&gt;init·사이드카를 붙인다&lt;br&gt;(어노테이션 agent-inject)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="212" height="120" as="geometry"/></mxCell><mxCell id="c2" value="② 로그인&lt;br&gt;vault-agent-init 이 서비스 계정&lt;br&gt;토큰을 내밀고&lt;br&gt;auth/kubernetes/login (역할 opslab-app)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="252" y="40" width="212" height="120" as="geometry"/></mxCell><mxCell id="c3" value="③ 토큰 검사&lt;br&gt;Vault → 쿠버네티스 API&lt;br&gt;TokenReview&lt;br&gt;(system:auth-delegator 권한)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#FFE6CC;strokeColor=#D79B00;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="484" y="40" width="212" height="120" as="geometry"/></mxCell><mxCell id="c4" value="④ 역할 조건&lt;br&gt;Auth 역할의 허용&lt;br&gt;서비스 계정·네임스페이스와 비교&lt;br&gt;→ 정책 opslab-app 이 붙은 토큰" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#FFE6CC;strokeColor=#D79B00;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="716" y="40" width="212" height="120" as="geometry"/></mxCell><mxCell id="c5" value="⑤ 비밀 읽기·파일&lt;br&gt;정책이 허용하면 secret/opslab/db&lt;br&gt;→ /etc/app/db-cred.env&lt;br&gt;앱이 DB 비밀번호로 사용" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#FFE6CC;strokeColor=#D79B00;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="948" y="40" width="212" height="120" as="geometry"/></mxCell><mxCell id="c6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="어디가 틀리면 무엇이 보이나 (kubectl logs &amp;lt;파드&amp;gt; -c vault-agent-init)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="20" y="200" width="1140" height="200" as="geometry"/></mxCell><mxCell id="c11" value="① 주입기 0개·어노테이션 없음&lt;br&gt;→ 사이드카 없이 뜸 → 비밀번호 파일 없음&lt;br&gt;→ 앱 CrashLoopBackOff" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#FFFFFF;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="260" height="130" as="geometry"/></mxCell><mxCell id="c12" value="②③ 로그인 실패&lt;br&gt;permission denied · connection refused&lt;br&gt;· tokenreviews forbidden&lt;br&gt;→ 파드 Init:0/2 에서 정지" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#FFFFFF;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="320" y="240" width="260" height="130" as="geometry"/></mxCell><mxCell id="c13" value="④ 네임스페이스·이름 불일치&lt;br&gt;&quot;namespace not authorized&quot;&lt;br&gt;→ Init 에서 정지" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#FFFFFF;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="600" y="240" width="260" height="130" as="geometry"/></mxCell><mxCell id="c14" value="⑤ 경로 오타·정책 없음&lt;br&gt;403 permission denied · 비밀 없음&lt;br&gt;→ Init 에서 계속 기다림" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#FFFFFF;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="880" y="240" width="260" height="130" as="geometry"/></mxCell><mxCell id="c15" value="봉인(sealed)된 Vault 는 모든 요청을 거절한다 — 먼저 vault status 와 vault-unsealer CronJob 을 본다" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="20" y="420" width="1140" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>