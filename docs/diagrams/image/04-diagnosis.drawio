<mxfile host="opslab"><diagram name="4. 진단 순서 — 새 버전이 운영에 안 보일 때"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="① 파이프라인 최근 실행: 어느 단계에서 멈췄나?" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#FFF2CC;strokeColor=#D6B656;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1140" height="50" as="geometry"/></mxCell><mxCell id="c2" value="Source 실패&lt;br&gt;GitHub 연결 상태&lt;br&gt;(AVAILABLE?)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="20" y="110" width="210" height="95" as="geometry"/></mxCell><mxCell id="c3" value="Build 실패&lt;br&gt;CodeBuild 단계(phase)&lt;br&gt;→ 로그 마지막 오류&lt;br&gt;(기본 이미지·권한·명세)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="250" y="110" width="250" height="95" as="geometry"/></mxCell><mxCell id="c4" value="Scan 실패&lt;br&gt;게이트 로그의 등급별 개수&lt;br&gt;→ ECR 스캔 결과(CVE)&lt;br&gt;→ 기본 이미지·기준 변경" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="520" y="110" width="280" height="95" as="geometry"/></mxCell><mxCell id="c5" value="모두 성공인데 운영이 그대로&lt;br&gt;= 빌드 성공 후 배포 실패&lt;br&gt;→ ②로" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#FFE6CC;strokeColor=#D79B00;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="820" y="110" width="340" height="95" as="geometry"/></mxCell><mxCell id="c6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c1" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c1" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c1" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="② 오늘 브랜치에 &#x27;image: &amp;lt;태그&amp;gt;&#x27; 커밋이 있나?&lt;br&gt;(gitfile.sh log)&lt;br&gt;없음 → Deploy 단계 로그·&lt;br&gt;배포 프로젝트 환경변수(브랜치·토큰)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="820" y="240" width="340" height="95" as="geometry"/></mxCell><mxCell id="c11" value="③ Argo CD 운영 앱: 리비전·이미지 파라미터가 새 태그인가?&lt;br&gt;(argocd app get opslab-prod)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="820" y="360" width="340" height="75" as="geometry"/></mxCell><mxCell id="c12" value="④ 파드: 새 파드가 이미지를 받았나?&lt;br&gt;ImagePullBackOff → 이미지 주소·ECR 에 태그가 있나" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="820" y="455" width="340" height="75" as="geometry"/></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="기록을 본다: 커밋 기록(누가 무엇을) · CloudTrail(권한·프로젝트 설정 변경) · 파이프라인 실행 기록" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="240" width="780" height="60" as="geometry"/></mxCell><mxCell id="c17" value="원인을 고친 뒤: 커밋을 푸시하거나 [변경 사항 릴리스]로 새 실행&lt;br&gt;(실패한 실행을 &#x27;다시 시도&#x27;하면 고장 난 소스로 다시 돈다)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="20" y="320" width="780" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>