<mxfile host="opslab"><diagram name="3. 태그 전략 · 수명주기 · 스캔 게이트"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="태그 불변(IMMUTABLE) — 같은 이름표는 다시 못 붙인다" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="360" height="300" as="geometry"/></mxCell><mxCell id="c2" value="푸시 :9c8d7e6 → ✅" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="40" y="65" width="320" height="45" as="geometry"/></mxCell><mxCell id="c3" value="같은 :9c8d7e6 다시 푸시 → ❌ 거부&lt;br&gt;(빌드 단계는 &#x27;이미 있으면 건너뜀&#x27;)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="40" y="125" width="320" height="60" as="geometry"/></mxCell><mxCell id="c4" value=":latest 같은 움직이는 태그를 쓰지 않는 이유&lt;br&gt;= 어제와 오늘 같은 이름, 다른 내용" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="320" height="60" as="geometry"/></mxCell><mxCell id="c5" value="수명주기 정책 — 창고 정리 규칙" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fillColor=#FFF4E5;strokeColor=#ED7100;" vertex="1" parent="1"><mxGeometry x="400" y="20" width="360" height="300" as="geometry"/></mxCell><mxCell id="c6" value="규칙 1: 태그 없는 이미지 → 1일 뒤 삭제" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="420" y="65" width="320" height="45" as="geometry"/></mxCell><mxCell id="c7" value="규칙 2: 이미지가 20개 넘으면 오래된 것부터 삭제" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="420" y="125" width="320" height="45" as="geometry"/></mxCell><mxCell id="c8" value="주의: 운영이 쓰는 옛 태그도&lt;br&gt;&#x27;오래됐다&#x27;는 이유로 지워질 수 있다&lt;br&gt;→ 미리보기(lifecycle preview)로 확인" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="420" y="190" width="320" height="75" as="geometry"/></mxCell><mxCell id="c9" value="스캔 게이트 — 출고 전 검사대" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="780" y="20" width="380" height="300" as="geometry"/></mxCell><mxCell id="c10" value="CRITICAL — 0개 허용" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="800" y="65" width="340" height="38" as="geometry"/></mxCell><mxCell id="c11" value="HIGH — 세지 않음" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="800" y="110" width="340" height="38" as="geometry"/></mxCell><mxCell id="c12" value="MEDIUM — 세지 않음" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="800" y="155" width="340" height="38" as="geometry"/></mxCell><mxCell id="c13" value="LOW — 세지 않음" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="800" y="200" width="340" height="38" as="geometry"/></mxCell><mxCell id="c14" value="기준: GATE_SEVERITY=CRITICAL, GATE_MAX=0&lt;br&gt;기준을 낮추면(LOW) 정상 이미지도 막힌다" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="800" y="250" width="340" height="55" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>